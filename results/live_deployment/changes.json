      "mcp-ai-agent-guidelines_1mcp_constitution-validator": {
        "kind": "added",
        "levels": [
          "Tool"
        ],
        "changes": [
          {
            "path": "/",
            "operation": "add",
            "after": {
              "tool": {
                "name": "mcp-ai-agent-guidelines_1mcp_constitution-validator",
                "description": "Validate any project artifact (spec.md, ADR, roadmap, plan, or custom document) against CONSTITUTION.md principles, constraints, and quality standards. Provides standalone constitutional compliance checking independent of generation workflows. BEST FOR: post-generation validation, constitutional compliance audits, artifact quality assurance. OUTPUTS: Detailed validation report with compliance score, principle violations, constraint breaches, and remediation recommendations.",
                "inputSchema": {
                  "type": "object",
                  "properties": {
                    "artifactContent": {
                      "type": "string",
                      "description": "Content of the artifact to validate (spec.md, ADR, roadmap, plan, etc.)"
                    },
                    "artifactType": {
                      "type": "string",
                      "enum": [
                        "spec",
                        "adr",
                        "roadmap",
                        "plan",
                        "tasks",
                        "progress",
                        "custom"
                      ],
                      "description": "Type of artifact being validated",
                      "default": "spec"
                    },
                    "constitutionPath": {
                      "type": "string",
                      "description": "Path to CONSTITUTION.md file (optional if constitutionContent provided)"
                    },
                    "constitutionContent": {
                      "type": "string",
                      "description": "CONSTITUTION.md content directly (optional if constitutionPath provided)"
                    },
                    "validationLevel": {
                      "type": "string",
                      "enum": [
                        "strict",
                        "standard",
                        "lenient"
                      ],
                      "description": "Validation strictness level",
                      "default": "standard"
                    },
                    "checkPrinciples": {
                      "type": "boolean",
                      "description": "Validate against constitutional principles",
                      "default": true
                    },
                    "checkConstraints": {
                      "type": "boolean",
                      "description": "Validate against constitutional constraints",
                      "default": true
                    },
                    "checkQualityStandards": {
                      "type": "boolean",
                      "description": "Validate against quality standards",
                      "default": true
                    },
                    "outputFormat": {
                      "type": "string",
                      "enum": [
                        "json",
                        "markdown",
                        "summary"
                      ],
                      "description": "Output format for validation results",
                      "default": "markdown"
                    },
                    "includeRecommendations": {
                      "type": "boolean",
                      "description": "Include remediation recommendations",
                      "default": true
                    },
                    "includeExamples": {
                      "type": "boolean",
                      "description": "Include compliant examples for violations",
                      "default": false
                    }
                  },
                  "required": [
                    "artifactContent"
                  ]
                },
                "server": "mcp-ai-agent-guidelines"
              },
              "routing": "mcp-ai-agent-guidelines_1mcp_constitution-validator"
            }
          }
        ]
      },
      "mcp-ai-agent-guidelines_1mcp_prompt-version-manager": {
        "kind": "added",
        "levels": [
          "Tool"
        ],
        "changes": [
          {
            "path": "/",
            "operation": "add",
            "after": {
              "tool": {
                "name": "mcp-ai-agent-guidelines_1mcp_prompt-version-manager",
                "description": "Version and manage prompt artifacts with save, list, diff, restore, and delete operations using an in-memory registry of named prompt versions and optional metadata output. BEST FOR: prompt lifecycle management, iterative prompt refinement, A/B comparison of prompt variants, rollback to previous prompt versions. OUTPUTS: Version metadata, line-level diffs between versions, restored prompt content, or deletion confirmation.",
                "inputSchema": {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": [
                        "save",
                        "list",
                        "diff",
                        "restore",
                        "delete"
                      ],
                      "description": "Operation to perform: 'save' stores a prompt version, 'list' shows all versions for a key, 'diff' computes line-level diff between two versions, 'restore' retrieves a specific version's content, 'delete' removes a version."
                    },
                    "key": {
                      "type": "string",
                      "description": "Logical name for the prompt (e.g., 'auth-system-prompt', 'onboarding-spec'). Groups versions under a shared identifier.",
                      "examples": [
                        "auth-system-prompt",
                        "payment-spec",
                        "onboarding-flow"
                      ]
                    },
                    "content": {
                      "type": "string",
                      "description": "Prompt content to save (required for 'save' action)."
                    },
                    "label": {
                      "type": "string",
                      "description": "Optional human-readable label for the version (e.g., 'v1-initial', 'v2-with-cot').",
                      "examples": [
                        "v1-initial",
                        "v2-chain-of-thought",
                        "v3-security-hardened"
                      ]
                    },
                    "versionA": {
                      "type": "string",
                      "description": "Version ID or label for the base side of a diff (required for 'diff' action)."
                    },
                    "versionB": {
                      "type": "string",
                      "description": "Version ID or label for the comparison side of a diff (required for 'diff' action). Omit to diff against the latest saved version."
                    },
                    "versionId": {
                      "type": "string",
                      "description": "Specific version ID to restore or delete (required for 'restore' and 'delete' actions)."
                    },
                    "includeMetadata": {
                      "type": "boolean",
                      "description": "Include version metadata (timestamp, label, character count) in the response.",
                      "default": true
                    }
                  },
                  "required": [
                    "action",
                    "key"
                  ]
                },
                "server": "mcp-ai-agent-guidelines"
              },
              "routing": "mcp-ai-agent-guidelines_1mcp_prompt-version-manager"
            }
          }
        ]
      }
    },
