      "mcp-ai-agent-guidelines_1mcp_constitution-validator": {
        "kind": "added",
        "levels": [
          "Tool"
        ],
        "changes": [
          {
            "path": "/",
            "operation": "add",
            "after": {
              "tool": {
                "name": "mcp-ai-agent-guidelines_1mcp_constitution-validator",
                "description": "Validate any project artifact (spec.md, ADR, roadmap, plan, or custom document) against CONSTITUTION.md principles, constraints, and quality standards. Provides standalone constitutional compliance checking independent of generation workflows. BEST FOR: post-generation validation, constitutional compliance audits, artifact quality assurance. OUTPUTS: Detailed validation report with compliance score, principle violations, constraint breaches, and remediation recommendations.",
                "inputSchema": {
                  "type": "object",
                  "properties": {
                    "artifactContent": {
                      "type": "string",
                      "description": "Content of the artifact to validate (spec.md, ADR, roadmap, plan, etc.)"
                    },
                    "artifactType": {
                      "type": "string",
                      "enum": [
                        "spec",
                        "adr",
                        "roadmap",
                        "plan",
                        "tasks",
                        "progress",
                        "custom"
                      ],
                      "description": "Type of artifact being validated",
                      "default": "spec"
                    },
                    "constitutionPath": {
                      "type": "string",
                      "description": "Path to CONSTITUTION.md file (optional if constitutionContent provided)"
                    },
                    "constitutionContent": {
                      "type": "string",
                      "description": "CONSTITUTION.md content directly (optional if constitutionPath provided)"
                    },
                    "validationLevel": {
                      "type": "string",
                      "enum": [
                        "strict",
                        "standard",
                        "lenient"
                      ],
                      "description": "Validation strictness level",
                      "default": "standard"
                    },
                    "checkPrinciples": {
                      "type": "boolean",
                      "description": "Validate against constitutional principles",
                      "default": true
                    },
                    "checkConstraints": {
                      "type": "boolean",
                      "description": "Validate against constitutional constraints",
                      "default": true
                    },
                    "checkQualityStandards": {
                      "type": "boolean",
                      "description": "Validate against quality standards",
                      "default": true
                    },
                    "outputFormat": {
                      "type": "string",
                      "enum": [
                        "json",
                        "markdown",
                        "summary"
                      ],
                      "description": "Output format for validation results",
                      "default": "markdown"
                    },
                    "includeRecommendations": {
                      "type": "boolean",
                      "description": "Include remediation recommendations",
                      "default": true
                    },
                    "includeExamples": {
                      "type": "boolean",
                      "description": "Include compliant examples for violations",
                      "default": false
                    }
                  },
                  "required": [
                    "artifactContent"
                  ]
                },
                "server": "mcp-ai-agent-guidelines"
              },
              "routing": "mcp-ai-agent-guidelines_1mcp_constitution-validator"
            }
          }
        ]
      }
    },
